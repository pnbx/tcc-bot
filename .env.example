# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""            # random; Telegram must send it back on every update
TELEGRAM_CHANNEL_ID=""                # e.g. -1001234567890 (for announcements)
BOT_ADMIN_IDS=""                      # comma-separated Telegram user IDs allowed to run staff commands

# TCC website API (site.tccmc.ir) — must equal BOT_API_TOKEN there
TCC_SITE_URL="https://site.tccmc.ir"
BOT_API_TOKEN=""

# OpenRouter (fallback chain: every key is tried before giving up)
OPENROUTER_API_KEYS=""
OPENROUTER_MODELS="z-ai/glm-5.2:free,nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.0-flash-vl:free,qwen/qwen3.8-27b:free"
